.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Dataset files must never be committed
data/personal/*
data/reference/*
!data/personal/.gitkeep
!data/reference/.gitkeep

# Engine evaluation cache: a disposable computed SQLite artifact, never a
# source of truth, never committed.
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Step 4C.0 calibration-evidence pilot: ALL generated experiment output is
# disposable computed data and is never committed. The harness code under
# src/chess_decision_explorer/experimental/ is tracked; its output is not.
experiments/
